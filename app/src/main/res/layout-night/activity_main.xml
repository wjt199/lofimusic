<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:fitsSystemWindows="true"
    android:gravity="center|top"
    android:orientation="vertical">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="6dp"
        android:layout_marginBottom="0dp"
        android:gravity="center"
        android:text="@string/lo_fi_music"
        android:textColor="#9E9746"
        android:textSize="28sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="19dp"
        android:gravity="center"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_date_week"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/date"
            android:textColor="#A8A2A2"
            android:textSize="24sp" />

        <TextView
            android:id="@+id/tv_lunar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lunarText"
            android:textColor="#878585"
            android:textSize="19sp" />
    </LinearLayout>

    <TextView
        android:id="@+id/tv_clock"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="24dp"
        android:fontFamily="monospace"
        android:gravity="center"
        android:text="@string/time"
        android:textColor="#D3CDCD"
        android:textSize="52sp"
        android:textStyle="bold" />

    <Spinner
        android:id="@+id/spinner_stations"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:background="#3E2723"
        android:gravity="center"
        android:minHeight="24dp"
        android:padding="0dp"
        tools:ignore="TouchTargetSizeCheck" />

    <ImageView
        android:id="@+id/image_view_slideshow"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:background="#2D2D2D"
        android:contentDescription="@string/todo"
        android:scaleType="fitXY"
        android:src="@drawable/img_0" />

    <LinearLayout
        style="?android:attr/buttonBarStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="0dp"
        android:gravity="center"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btn_prev"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#5D4037"
            android:text="@string/prev"
            android:textColor="#FFD54F"
            android:textSize="16sp"
            tools:ignore="VisualLintButtonSize" />

        <Button
            android:id="@+id/btn_play_pause"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#7B1FA2"
            android:text="@string/pause"
            android:textColor="#BCB7B7"
            android:textSize="16sp"
            tools:ignore="VisualLintButtonSize" />

        <Button
            android:id="@+id/btn_next"
            style="?android:attr/buttonBarButtonStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="2dp"
            android:layout_weight="1"
            android:backgroundTint="#5D4037"
            android:text="@string/next"
            android:textColor="#FFD54F"
            android:textSize="16sp"
            tools:ignore="VisualLintButtonSize" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="start|center"
        android:orientation="vertical"
        tools:ignore="VisualLintBounds">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="30dp"
            android:layout_margin="2dp"
            android:gravity="center"
            android:text="@string/quit_after"
            android:textColor="#948F8F"
            android:textSize="21sp"
            android:textStyle="bold"
            tools:ignore="TextSizeCheck,VisualLintBounds" />

        <LinearLayout
            style="?android:attr/buttonBarStyle"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="2"
            android:gravity="center"
            android:orientation="horizontal"
            tools:ignore="VisualLintBounds">

            <Button
                android:id="@+id/btn_15min"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/_15min"
                tools:ignore="NestedWeights,VisualLintButtonSize" />

            <Button
                android:id="@+id/btn_30min"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/_30min" />

            <Button
                android:id="@+id/btn_45min"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/_45min" />

            <Button
                android:id="@+id/btn_60min"
                style="?android:attr/buttonBarButtonStyle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_margin="2dp"
                android:layout_weight="1"
                android:text="@string/_60min"
                tools:ignore="VisualLintButtonSize" />
        </LinearLayout>

        <TextView
            android:id="@+id/tv_timer_status"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:text="@string/quit_time_unset"
            android:textColor="#A0A0A0"
            android:textSize="19sp"
            tools:ignore="VisualLintBounds" />
    </LinearLayout>

    <Button
        android:id="@+id/btn_exit"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="#5B1313"
        android:text="@string/quit"
        android:textColor="#959595"
        android:textSize="19sp"
        tools:ignore="VisualLintButtonSize,VisualLintBounds" />
</LinearLayout>